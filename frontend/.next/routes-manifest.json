{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/matches/[id]",
      "regex": "^/matches/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/matches/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/matches/[id]/edit",
      "regex": "^/matches/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/matches/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/players/[id]",
      "regex": "^/players/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/players/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/players/[id]/edit",
      "regex": "^/players/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/players/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/tournaments/[id]",
      "regex": "^/tournaments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tournaments/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tournaments/[id]/bracket",
      "regex": "^/tournaments/([^/]+?)/bracket(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tournaments/(?<nxtPid>[^/]+?)/bracket(?:/)?$"
    },
    {
      "page": "/tournaments/[id]/edit",
      "regex": "^/tournaments/([^/]+?)/edit(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tournaments/(?<nxtPid>[^/]+?)/edit(?:/)?$"
    },
    {
      "page": "/tournaments/[id]/standings",
      "regex": "^/tournaments/([^/]+?)/standings(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/tournaments/(?<nxtPid>[^/]+?)/standings(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/create",
