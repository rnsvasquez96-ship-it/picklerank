generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  startDate   DateTime
  endDate     DateTime
  maxPlayers  Int
  status      String   @default("Upcoming")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}