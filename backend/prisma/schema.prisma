generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tournament {
  id         Int      @id @default(autoincrement())
  name       String
  location   String
  startDate  DateTime
  endDate    DateTime
  maxPlayers Int
  status     String   @default("Upcoming")
  format     String   @default("Single Elimination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]
  registrations Registration[]
}

model Player {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  skill     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsPlayer1 Match[] @relation("PlayerOne")
  matchesAsPlayer2 Match[] @relation("PlayerTwo")
  matchesWon       Match[] @relation("Winner")
  registrations Registration[]
}

model Match {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament   Tournament @relation(fields: [tournamentId], references: [id])

  player1Id Int
  player1   Player @relation("PlayerOne", fields: [player1Id], references: [id])

  player2Id Int
  player2   Player @relation("PlayerTwo", fields: [player2Id], references: [id])

  player1Score Int @default(0)
  player2Score Int @default(0)

  winnerId Int?
  winner   Player? @relation("Winner", fields: [winnerId], references: [id])

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round Int @default(1)
}

model Registration {
  id Int @id @default(autoincrement())

  tournamentId Int
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  playerId Int
  player Player @relation(fields: [playerId], references: [id])

  seed Int?

  createdAt DateTime @default(now())

  @@unique([tournamentId, playerId])
}
